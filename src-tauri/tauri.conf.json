{
  "$schema": "https://raw.githubusercontent.com/nicegui-tech/tauri-v2/main/tooling/cli/schema.json",
  "productName": "Tomato Clock",
  "version": "1.0.0",
  "identifier": "com.tomato-clock",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Tomato Clock",
        "width": 400,
        "height": 500,
        "resizable": true,
        "center": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "single-instance": {
      "enabled": true
    }
  }
}
